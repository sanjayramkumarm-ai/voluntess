import { Schema, model } from "mongoose";

const conversationSchema = new Schema(
  {
    application: { type: Schema.Types.ObjectId, ref: "Application", required: true, unique: true },
    opportunity: { type: Schema.Types.ObjectId, ref: "Opportunity", required: true },
    volunteer: { type: Schema.Types.ObjectId, ref: "User", required: true },
    ngo: { type: Schema.Types.ObjectId, ref: "User", required: true },
    lastMessage: { type: String, default: "" },
    lastMessageAt: { type: Date, default: Date.now },
    volunteerUnread: { type: Number, default: 0 },
    ngoUnread: { type: Number, default: 0 },
  },
  { timestamps: true }
);

conversationSchema.index({ volunteer: 1, lastMessageAt: -1 });
conversationSchema.index({ ngo: 1, lastMessageAt: -1 });

export default model("Conversation", conversationSchema);